VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DEMO_MODE=false
# Public Google entry points. Keep false in production until beta access opens.
VITE_PUBLIC_AUTH_ENABLED=false
# Optional MapLibre-compatible style. Defaults to OpenFreeMap Liberty.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Optional Nominatim-compatible endpoint for submit-only place search.
VITE_GEOCODING_SEARCH_URL=https://nominatim.openstreetmap.org/search
